# GrainGuardian — Environment Configuration Template
# Copy this file to .env before starting the stack

# Database Credentials (PostgreSQL)
POSTGRES_USER=grainguardian
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=grainguardian
DATABASE_URL=postgresql+psycopg2://grainguardian:your_secure_postgres_password_here@localhost:5432/grainguardian

# Backend Security
SECRET_KEY=change_this_to_a_random_cryptographic_secret_key_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Host & Ports
BACKEND_PORT=8000
API_V1_STR=/api/v1
